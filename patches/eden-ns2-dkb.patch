+TEST_CASE("Native floating min/max clamps actual shader input", "[native-shader]") {
+    const std::array<Native, 5> input{{
+        {{0xff007321, 0x000080ff, 0x00000000, 0x000e2200}},
+        {{0x00007a09, 0x00c00000, 0x07810000, 0x000fe400}},
