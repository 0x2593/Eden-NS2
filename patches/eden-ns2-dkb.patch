diff --git a/src/video_core/native_qmd.h b/src/video_core/native_qmd.h
new file mode 100644
index 0000000..3a98591
--- /dev/null
+++ b/src/video_core/native_qmd.h
@@ -0,0 +1,131 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdlib>
+#include <array>
+#include <cstdint>
+#include <string_view>
+#include <type_traits>
+#include <unordered_map>
+
+namespace Tegra {
+
+// Native QMD 3.0 dependency scheduling; nonempty grids require a dispatch backend.
+class NativeQmdScheduler {
+public:
+    using Word = std::uint32_t;
+    using Address = std::uint64_t;
+    using Descriptor = std::array<Word, 64>;
+    static constexpr std::array<Word, 3> ReleaseWords{24, 28, 52};
+    struct DiagnosticState {
+        std::int32_t dependencies{};
+        std::int32_t deferred{};
+        Word flags{};
+    };
+    DiagnosticState Inspect(Address address) const {
+        const auto it = states.find(address);
+        if (it == states.end()) return {};
+        const auto& state = it->second;
+        return {state.dependencies, state.deferred,
+                Word(state.loaded) | Word(state.scheduled) << 1 | Word(state.completed) << 2};
+    }
+    struct RejectShaderDispatch { bool operator()(const Descriptor&) const { return false; } };
+    template <typename Read, typename Release>
+    std::string_view Signal(Address address, Word argument, Read read, Release release) {
+        return Signal(address, argument, read, release, RejectShaderDispatch{});
+    }
+    template <typename Read, typename Release, typename Dispatch>
+    std::string_view Signal(Address address, Word argument, Read read, Release release, Dispatch dispatch) {
+        struct Pending { Address address; Word action; Word count; };
+        // Outside EDEN_NATIVE_STRICT, a dispatch the backend cannot run is skipped but still
+        // completes, so its semaphore releases and dependent QMDs do not leave the game waiting.
+        static const bool strict = std::getenv("EDEN_NATIVE_STRICT") != nullptr;
+        bool dispatch_skipped = false;
+        std::array<Pending, 256> pending{};
+        std::size_t count = 1;
+        pending[0] = {address, argument & 15, ((argument >> 14) & 0x3ff) + 1};
+        for (std::size_t i = 0; i < count; ++i) {
+            const auto request = pending[i];
+            auto& state = states[request.address];
+            if (request.action == 3 || request.action == 2) {
+                if (request.action == 3 || !state.loaded) {
+                    if (!read(request.address, state.descriptor)) return "unmapped QMD";
+                    const auto& qmd = state.descriptor;
+                    if ((qmd[18] & 0xff) != 0x30 || (qmd[4] & 0x100)) return "unsupported QMD version or queue";
+                    if constexpr (std::is_same_v<Dispatch, RejectShaderDispatch>) {
+                        if (qmd[12] && (qmd[13] & 0xffff) && (qmd[14] & 0xffff))
+                            return "native shader dispatch required";
+                    }
+                    state.dependencies = std::int32_t((qmd[4] >> 14) & 0xffff) + state.deferred;
+                    state.deferred = 0;
+                    state.loaded = true;
+                    state.completed = false;
+                }
+                state.scheduled = true;
+            } else if (request.action == 7 || request.action == 12) {
+                const auto delta = request.action == 7 ? -std::int32_t(request.count) : std::int32_t(request.count);
+                if (!state.loaded || state.completed) { state.deferred += delta; continue; }
+                state.dependencies += delta;
+            } else if (request.action == 0 || request.action == 1) {
+                continue;
+            } else {
+                return "unsupported PCAS action";
+            }
+            if (!state.loaded || !state.scheduled || state.completed || state.dependencies > 0) continue;
+            if (state.dependencies < 0) return "QMD dependency underflow";
+            // The SDK patches release payloads while a scheduled QMD is
+            // waiting for its remaining dependencies. Fetch them at execution.
+            if (!read(request.address, state.descriptor)) return "unmapped QMD";
+            const auto qmd = state.descriptor;
+            if ((qmd[18] & 0xff) != 0x30 || (qmd[4] & 0x100)) return "unsupported QMD version or queue";
+            // Validate every release slot before making any visible.
+            for (const Word base : ReleaseWords) {
+                const Word flags = qmd[base + 1];
+                if (!(flags & (1U << 23))) continue;
+                const bool add = (flags & (1U << 26)) != 0;
+                if ((flags & (0x3bU << 24)) || (flags >> 30) != 1 ||
+                    (add && (flags & (7U << 20)))) return "unsupported QMD release format";
+                if (add) {
+                    if constexpr (!std::is_invocable_r_v<bool, Release, Address, Word, Word>)
+                        return "unsupported QMD reduction callback";
+                }
+            }
+            if (qmd[12] && (qmd[13] & 0xffff) && (qmd[14] & 0xffff) && !dispatch(qmd)) {
+                if (strict) return "native shader dispatch required";
+                dispatch_skipped = true;
+            }
+            state.completed = true;
+            for (const Word base : ReleaseWords) {
+                const Word flags = qmd[base + 1];
+                if (!(flags & (1U << 23))) continue;
+                const Address destination = (Address{flags & 0xff} << 32) | qmd[base];
+                bool released{};
+                if constexpr (std::is_invocable_r_v<bool, Release, Address, Word, Word>) {
+                    released = release(destination, qmd[base + 2], flags);
+                } else {
+                    released = release(destination, qmd[base + 2]);
+                }
+                if (!released) return "unmapped QMD release";
+            }
+            if (qmd[16] & 1) {
+                const Word action = (qmd[16] >> 1) & 7;
+                if (action != 4 && action != 3 && action != 1) return "unsupported dependent QMD action";
+                if (count == pending.size()) return "QMD chain limit";
+                pending[count++] = {Address{qmd[15]} << 8, action == 4 ? 7U : action == 3 ? 3U : 2U, 1};
+            }
+            if (qmd[16] & (1U << 5)) return "second dependent QMD unsupported";
+        }
+        return dispatch_skipped ? std::string_view{"native shader dispatch skipped"} : std::string_view{};
+    }
+private:
+    struct State {
+        Descriptor descriptor{};
+        std::int32_t dependencies{};
+        std::int32_t deferred{};
+        bool loaded{};
+        bool scheduled{};
+        bool completed{};
+    };
+    std::unordered_map<Address, State> states;
+};
+} // namespace Tegra
diff --git a/src/video_core/native_query_trace.h b/src/video_core/native_query_trace.h
new file mode 100644
index 0000000..bc98e86
--- /dev/null
+++ b/src/video_core/native_query_trace.h
@@ -0,0 +1,44 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include "video_core/native_diagnostics.h"
+#include <cstdlib>
+#include <fstream>
+#include <iomanip>
+#include <mutex>
+#include "common/common_types.h"
+
+namespace VideoCommon {
+namespace NativeQueryDiagnostics {
+struct State {
+    State() : file{"native-query-trace.csv", std::ios::trunc} {
+        file << "event,asid,gpu,cpu,type,value,flags\n";
+    }
+    std::mutex mutex;
+    std::ofstream file;
+    size_t records{};
+};
+inline State& GetState() {
+    static State state;
+    return state;
+}
+} // namespace NativeQueryDiagnostics
+
+// Events: 0=request, 1=written, 2=invalidated, 3=unsynchronized,
+// 4=channel suspended, 5=channel resumed (type=current, flags=operation | channel<<8),
+// 6=buffer readback,
+// 7/8=QMD release slots observed, 9=PCAS request,
+// 10=DMA destination (value=source, flags=line bytes), 11=inline write.
+// Keep this opt-in and bounded.
+inline void TraceNativeQuery(u32 event, u64 asid, u64 gpu, u64 cpu, u32 type, u64 value, u32 flags) {
+    if (!NativeDrawDiagnosticsEnabled()) return;
+    auto& state = NativeQueryDiagnostics::GetState();
+    const std::scoped_lock lock{state.mutex};
+    if (state.records++ < 10000000 || event == 4 || event == 5) {
+        state.file << event << ',' << asid << ',' << std::hex << gpu << ',' << cpu << ','
+                   << type << ',' << value << ',' << flags << std::dec << '\n';
+    }
+    if (event == 4 || event == 5) state.file.flush();
+}
+} // namespace VideoCommon
diff --git a/src/video_core/native_root_table.h b/src/video_core/native_root_table.h
new file mode 100644
index 0000000..89cb4ae
--- /dev/null
+++ b/src/video_core/native_root_table.h
@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace Tegra {
+
+class NativeRootTables {
+public:
+    static constexpr std::uint32_t FirstBank = 24;
+    static constexpr std::uint32_t Count = 8;
+    static constexpr std::uint32_t Size = 256;
+    static constexpr std::uint32_t SelectorMethod = 0x0504 / 4;
+    static constexpr std::uint32_t LoadMethod = 0x0508 / 4;
+    using Table = std::array<std::uint32_t, Size / 4>;
+
+    static constexpr bool IsBank(std::uint32_t bank) {
+        return bank >= FirstBank && bank - FirstBank < Count;
+    }
+
+    void Select(std::uint32_t value) {
+        selected = value & 7;
+        offset = (value >> 8) & 255;
+    }
+
+    bool Load(std::uint32_t value) {
+        if (offset % 4 || offset >= Size) return false;
+        tables[selected][offset / 4] = value;
+        offset += 4;
+        return true;
+    }
+
+    const Table& Data(std::uint32_t bank) const {
+        return tables.at(bank - FirstBank);
+    }
+
+    std::uint32_t Read(std::uint32_t bank, std::uint32_t byte_offset) const {
+        if (!IsBank(bank) || byte_offset % 4 || byte_offset >= Size) return 0;
+        return Data(bank)[byte_offset / 4];
+    }
+
+private:
+    std::array<Table, Count> tables{};
+    std::uint32_t selected{}, offset{};
+};
+
+} // namespace Tegra
diff --git a/src/video_core/native_semaphore.h b/src/video_core/native_semaphore.h
new file mode 100644
index 0000000..1ba7451
--- /dev/null
+++ b/src/video_core/native_semaphore.h
@@ -0,0 +1,44 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace Tegra {
+struct NativeSemaphoreWait {
+    std::uint64_t address;
+    std::uint32_t value;
+    std::uint32_t operation;
+
+    static constexpr bool Supported(std::uint32_t operation) {
+        return operation == 1 || operation == 4 || operation == 8;
+    }
+    constexpr bool Matches(std::uint32_t current) const {
+        switch (operation) {
+        case 1: return current == value;
+        case 4: return current >= value;
+        case 8: return (current & value) != 0;
+        default: return false;
+        }
+    }
+};
+
+// Revisit dependencies after another channel makes progress. A blocked
+// channel keeps its FIFO cursor until its real semaphore predicate is true.
+template <class Channels, class Ready, class Dispatch>
+std::size_t ResumeReadyNativeChannels(const Channels& channels, Ready ready, Dispatch dispatch) {
+    std::size_t resumed = 0;
+    for (std::size_t pass = 0; pass < channels.size(); ++pass) {
+        bool progress = false;
+        for (const auto& channel : channels) {
+            if (!ready(channel)) continue;
+            dispatch(channel);
+            ++resumed;
+            progress = true;
+        }
+        if (!progress) break;
+    }
+    return resumed;
+}
+} // namespace Tegra
diff --git a/src/video_core/native_texture_capture.h b/src/video_core/native_texture_capture.h
new file mode 100644
index 0000000..a51cbeb
--- /dev/null
+++ b/src/video_core/native_texture_capture.h
@@ -0,0 +1,140 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <filesystem>
+#include <fstream>
+#include <set>
+#include <string>
+#include <vector>
+#include "common/logging.h"
+#include "video_core/native_diagnostics.h"
+#include "video_core/memory_manager.h"
+#include "video_core/texture_cache/image_base.h"
+#include "video_core/texture_cache/image_view_base.h"
+#include "video_core/texture_cache/util.h"
+
+namespace VideoCommon {
+namespace NativeTextureCapture {
+struct State {
+    u32 epoch{};
+    u32 remaining_draws{};
+    u32 image_count{};
+    size_t bytes{};
+    bool active{};
+    std::set<std::array<u64, 4>> images;
+    std::set<u32> samplers;
+};
+inline State& GetState() {
+    static thread_local State state;
+    return state;
+}
+inline void Write(const std::string& path, const void* data, size_t size) {
+    std::ofstream file(path, std::ios::binary);
+    file.write(static_cast<const char*>(data), size);
+}
+} // namespace NativeTextureCapture
+
+// Opt-in, bounded snapshots of the textures used by a short sequence of draws.
+inline bool BeginNativeTextureCapture() {
+    if (!NativeDrawDiagnosticsEnabled()) return false;
+    auto& state = NativeTextureCapture::GetState();
+    std::error_code error;
+    if (std::filesystem::remove("native-textures.request", error)) {
+        ++state.epoch;
+        state.remaining_draws = 64;
+        state.image_count = 0;
+        state.bytes = 0;
+        state.images.clear();
+        state.samplers.clear();
+    }
+    state.active = state.remaining_draws != 0;
+    if (state.active) --state.remaining_draws;
+    return state.active;
+}
+
+inline void CaptureNativeTexture(Tegra::MemoryManager& memory, u32 index,
+                                 const Tegra::Texture::TICEntry& descriptor,
+                                 const ImageViewBase& view, const ImageBase& image) {
+    auto& state = NativeTextureCapture::GetState();
+    if (!state.active || state.images.size() >= 64 || !state.images.insert(descriptor.raw).second)
+        return;
+    const std::string prefix = "native-texture-" + std::to_string(state.epoch) + "-" +
+                               std::to_string(state.image_count++);
+    NativeTextureCapture::Write(prefix + ".tic.bin", &descriptor, sizeof(descriptor));
+    const auto& info = image.info;
+    std::ofstream metadata(prefix + ".txt");
+    metadata << "index " << index << "\ngpu " << std::hex << image.gpu_addr << std::dec
+             << "\nview_gpu " << std::hex << view.gpu_addr << std::dec
+             << "\npixel_format " << static_cast<u32>(info.format)
+             << "\nguest_format " << static_cast<u32>(descriptor.format.Value())
+             << "\nimage_type " << static_cast<u32>(info.type)
+             << "\nview_type " << static_cast<u32>(view.type)
+             << "\nsize " << info.size.width << ' ' << info.size.height << ' ' << info.size.depth
+             << "\nview_size " << view.size.width << ' ' << view.size.height << ' ' << view.size.depth
+             << "\nresources " << info.resources.levels << ' ' << info.resources.layers
+             << "\nview_range " << view.range.base.level << ' ' << view.range.base.layer << ' '
+             << view.range.extent.levels << ' ' << view.range.extent.layers
+             << "\nblock " << info.block.width << ' ' << info.block.height << ' ' << info.block.depth
+             << "\npitch " << info.pitch << "\nlayer_stride " << info.layer_stride
+             << "\ntile_width_spacing " << info.tile_width_spacing
+             << "\nformat_block " << VideoCore::Surface::DefaultBlockWidth(info.format) << ' '
+             << VideoCore::Surface::DefaultBlockHeight(info.format) << ' '
+             << VideoCore::Surface::BytesPerBlock(info.format)
+             << "\nnative_tiling " << info.native_tiling
+             << "\nflags " << static_cast<u32>(image.flags)
+             << "\nguest_bytes " << image.guest_size_bytes
+             << "\nlinear_bytes " << image.unswizzled_size_bytes
+             << "\nconverted_bytes " << image.converted_size_bytes << '\n';
+    if (True(image.flags & ImageFlagBits::GpuModified)) {
+        metadata << "skipped gpu_modified_source\n";
+        return;
+    }
+    constexpr size_t budget = 128 * 1024 * 1024;
+    const size_t size = size_t{image.guest_size_bytes} + image.unswizzled_size_bytes + image.converted_size_bytes;
+    if (!image.guest_size_bytes || image.guest_size_bytes > 16 * 1024 * 1024 ||
+        image.unswizzled_size_bytes > 32 * 1024 * 1024 || image.converted_size_bytes > 64 * 1024 * 1024 ||
+        size > budget - state.bytes || !memory.IsFullyMappedRange(image.gpu_addr, image.guest_size_bytes)) {
+        metadata << "skipped size_budget_or_mapping\n";
+        return;
+    }
+    state.bytes += size;
+    std::vector<u8> raw(image.guest_size_bytes);
+    memory.ReadBlockUnsafe(image.gpu_addr, raw.data(), raw.size());
+    NativeTextureCapture::Write(prefix + ".raw.bin", raw.data(), raw.size());
+    std::vector<u8> linear(image.unswizzled_size_bytes);
+    auto copies = UnswizzleImage(memory, image.gpu_addr, info, raw, linear);
+    NativeTextureCapture::Write(prefix + ".linear.bin", linear.data(), linear.size());
+    for (const auto& copy : copies) {
+        metadata << "copy " << copy.buffer_offset << ' ' << copy.buffer_size << ' '
+                 << copy.buffer_row_length << ' ' << copy.buffer_image_height << ' '
+                 << copy.image_subresource.base_level << ' ' << copy.image_subresource.base_layer << ' '
+                 << copy.image_subresource.num_layers << ' ' << copy.image_extent.width << ' '
+                 << copy.image_extent.height << ' ' << copy.image_extent.depth << '\n';
+    }
+    if (True(image.flags & ImageFlagBits::Converted) && image.converted_size_bytes) {
+        std::vector<u8> converted(image.converted_size_bytes);
+        ConvertImage(linear, info, converted, copies);
+        NativeTextureCapture::Write(prefix + ".converted.bin", converted.data(), converted.size());
+    }
+    LOG_WARNING(HW_GPU, "Native texture capture {}: index={}, address={:#x}, dimensions={}x{}, format={}",
+                prefix, index, image.gpu_addr, info.size.width, info.size.height, static_cast<u32>(info.format));
+}
+
+inline void CaptureNativeSampler(u32 index, const Tegra::Texture::TSCEntry& descriptor) {
+    auto& state = NativeTextureCapture::GetState();
+    if (!state.active || state.samplers.size() >= 64 || !state.samplers.insert(index).second) return;
+    const std::string prefix = "native-sampler-" + std::to_string(state.epoch) + "-" + std::to_string(index);
+    NativeTextureCapture::Write(prefix + ".tsc.bin", &descriptor, sizeof(descriptor));
+    std::ofstream metadata(prefix + ".txt");
+    metadata << "index " << index << "\nwrap " << static_cast<u32>(descriptor.wrap_u.Value()) << ' '
+             << static_cast<u32>(descriptor.wrap_v.Value()) << ' ' << static_cast<u32>(descriptor.wrap_p.Value())
+             << "\nfilter " << static_cast<u32>(descriptor.mag_filter.Value()) << ' '
+             << static_cast<u32>(descriptor.min_filter.Value()) << ' '
+             << static_cast<u32>(descriptor.mipmap_filter.Value())
+             << "\nlod_bias " << descriptor.LodBias()
+             << "\nlod_clamp " << descriptor.min_lod_clamp.Value() << ' ' << descriptor.max_lod_clamp.Value()
+             << "\nnormalized " << descriptor.float_coord_normalization.Value() << '\n';
+}
+} // namespace VideoCommon
diff --git a/src/video_core/native_vprs.h b/src/video_core/native_vprs.h
new file mode 100644
index 0000000..8df6e81
--- /dev/null
+++ b/src/video_core/native_vprs.h
@@ -0,0 +1,40 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <span>
+#include "common/common_types.h"
+namespace Tegra {
+// NVC797_SET_VARIABLE_PIXEL_RATE_SHADING_CONTROL(j), ENABLE bit 0.
+inline u32 NativeVprsEnabledTables(std::span<const u32, 16> controls) {
+    u32 enabled{};
+    for (u32 index = 0; index < controls.size(); ++index)
+        enabled |= (controls[index] & 1U) << index;
+    return enabled;
+}
+
+struct NativeVprsFallback {
+    u32 enabled{};
+    u32 coarse{};
+    u32 unsupported{};
+    bool AllowsFullRate(bool fragment_writes_memory) const {
+        return unsupported == 0 && (!fragment_writes_memory || coarse == 0);
+    }
+};
+// Native rate 5 is one invocation per pixel; 6..11 are coarse rates.
+inline NativeVprsFallback ClassifyNativeVprs(std::span<const u32,16> controls,
+                                            std::span<const u32,16> rates_a,
+                                            std::span<const u32,16> rates_b) {
+    NativeVprsFallback result;
+    result.enabled = NativeVprsEnabledTables(controls);
+    for (u32 table = 0; table < controls.size(); ++table) {
+        if (!(result.enabled & (1U << table))) continue;
+        for (u32 index = 0; index < 16; ++index) {
+            const u32 packed = index < 8 ? rates_a[table] : rates_b[table];
+            const u32 rate = (packed >> ((index & 7) * 4)) & 15U;
+            if (rate < 5 || rate > 11) result.unsupported |= 1U << table;
+            else if (rate > 5) result.coarse |= 1U << table;
+        }
+    }
+    return result;
+}
+}
diff --git a/src/video_core/nx2.h b/src/video_core/nx2.h
new file mode 100644
index 0000000..41ddd1a
--- /dev/null
+++ b/src/video_core/nx2.h
@@ -0,0 +1,185 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <mutex>
+#include <vector>
+
+#include "common/common_types.h"
+
+namespace Tegra {
+
+// Set once a Switch 2 (Ampere, NVN2) driver is talking to the GPU. Its command streams use
+// Ampere classes and the Turing+ macro ISA, which Eden's Maxwell engines don't implement.
+inline std::atomic<bool> g_nx2_ampere{false};
+
+// Set once a channel with the native (Switch 2) ABI binds its 3D engine: the GPU thread split
+// (gpu_split.h) starts for those titles.
+inline std::atomic<bool> g_native_channels{false};
+
+// Device pages the GPU has written through the buffer cache (shader stores, copies), ever. Mario
+// Kart World runs small command lists its culling dispatches fill in each frame; read without a
+// flush they hold an older frame's words. The bits never clear: the dispatch that rewrites a page
+// may still be queued on the split's back when its front reads the command list. One bit per
+// 4 KiB of the 36-bit device address space (2 MiB).
+inline constexpr u64 Nx2WrittenPageBits = 12;
+inline std::array<std::atomic<u64>, (u64{1} << (36 - Nx2WrittenPageBits)) / 64> g_nx2_gpu_written_pages{};
+
+inline void Nx2MarkGpuWritten(u64 device_address, u64 size) {
+    if (size == 0) {
+        return;
+    }
+    const u64 last = (std::min)((device_address + size - 1) >> Nx2WrittenPageBits,
+                                u64{g_nx2_gpu_written_pages.size()} * 64 - 1);
+    for (u64 page = device_address >> Nx2WrittenPageBits; page <= last; ++page) {
+        auto& word = g_nx2_gpu_written_pages[page / 64];
+        const u64 bit = u64{1} << (page % 64);
+        if ((word.load(std::memory_order_relaxed) & bit) == 0) {
+            word.fetch_or(bit, std::memory_order_relaxed);
+        }
+    }
+}
+
+/// A new emulation session starts: no page has been written by its GPU yet.
+inline void Nx2ClearGpuWrittenPages() {
+    for (auto& word : g_nx2_gpu_written_pages) {
+        word.store(0, std::memory_order_relaxed);
+    }
+}
+
+[[nodiscard]] inline bool Nx2IsGpuWritten(u64 device_address) {
+    const u64 page = device_address >> Nx2WrittenPageBits;
+    if (page >= u64{g_nx2_gpu_written_pages.size()} * 64) {
+        return false;
+    }
+    return (g_nx2_gpu_written_pages[page / 64].load(std::memory_order_relaxed) >> (page % 64)) & 1;
+}
+
+// NVN2 queues release their progress values into the second page of a two-page GPU-accessible
+// region and GPU acquires read the same offsets in the first page (the CPU polls the second).
+// Something on the console copies one into the other; until that is known, the puller mirrors
+// releases that land in a second page. Every queue has such a region, so keep a small table.
+inline constexpr size_t Nx2MaxSemaphoreRegions = 32;
+inline std::array<std::atomic<u64>, Nx2MaxSemaphoreRegions> g_nx2_semaphore_regions{}; // starts
+
+inline void Nx2AddSemaphoreRegion(u64 start) {
+    for (auto& region : g_nx2_semaphore_regions) {
+        if (region.load() == start) {
+            return;
+        }
+    }
+    for (auto& region : g_nx2_semaphore_regions) {
+        u64 expected = 0;
+        if (region.compare_exchange_strong(expected, start)) {
+            return;
+        }
+    }
+}
+
+/// The region's memory was destroyed: stop mirroring into it.
+inline void Nx2RemoveSemaphoreRegion(u64 start) {
+    for (auto& region : g_nx2_semaphore_regions) {
+        u64 expected = start;
+        region.compare_exchange_strong(expected, 0);
+    }
+}
+
+/// GPU VA in the first page that mirrors a release at `address`, or 0.
+inline u64 Nx2SemaphoreMirror(u64 address) {
+    for (const auto& region : g_nx2_semaphore_regions) {
+        const u64 start = region.load(std::memory_order_relaxed);
+        if (start == 0) {
+            continue;
+        }
+        if (address >= start + 0x1000 && address < start + 0x2000) {
+            return address - 0x1000;
+        }
+    }
+    return 0;
+}
+
+/// Channels suspended on a semaphore acquire. A console channel polls and sees every release;
+/// Eden writes releases in bursts when fences signal and resumes waiters only between command
+/// lists, so an acquire-equal could miss its value. Writes latch the waiters they satisfy.
+class Nx2SemaphoreWaiters {
+public:
+    // Puller GpuSemaphoreOperation values.
+    static constexpr u32 AcquireEqual = 0x1;
+    static constexpr u32 AcquireGequal = 0x4;
+    static constexpr u32 AcquireMask = 0x8;
+
+    static Nx2SemaphoreWaiters& Get() {
+        static Nx2SemaphoreWaiters waiters;
+        return waiters;
+    }
+
+    void Add(const void* owner, u64 device_address, u32 value, u32 operation) {
+        std::scoped_lock lk{mutex};
+        std::erase_if(waiters, [owner](const Waiter& w) { return w.owner == owner; });
+        waiters.push_back({owner, device_address, value, operation, false});
+        count.store(waiters.size(), std::memory_order_release);
+    }
+
+    void Remove(const void* owner) {
+        if (count.load(std::memory_order_acquire) == 0) {
+            return;
+        }
+        std::scoped_lock lk{mutex};
+        std::erase_if(waiters, [owner](const Waiter& w) { return w.owner == owner; });
+        count.store(waiters.size(), std::memory_order_release);
+    }
+
+    [[nodiscard]] bool Latched(const void* owner) {
+        if (count.load(std::memory_order_acquire) == 0) {
+            return false;
+        }
+        std::scoped_lock lk{mutex};
+        return std::ranges::any_of(waiters,
+                                   [owner](const Waiter& w) { return w.owner == owner && w.latched; });
+    }
+
+    /// A GPU write of `value` to the u32 at `device_address`.
+    void OnWrite(u64 device_address, u32 value) {
+        if (count.load(std::memory_order_acquire) == 0) {
+            return;
+        }
+        std::scoped_lock lk{mutex};
+        for (auto& w : waiters) {
+            if (w.address == device_address && !w.latched && Matches(w, value)) {
+                w.latched = true;
+            }
+        }
+    }
+
+private:
+    struct Waiter {
+        const void* owner;
+        u64 address;
+        u32 value;
+        u32 operation;
+        bool latched;
+    };
+
+    static bool Matches(const Waiter& w, u32 current) {
+        switch (w.operation) {
+        case AcquireEqual:
+            return current == w.value;
+        case AcquireGequal:
+            return current >= w.value;
+        case AcquireMask:
+            return (current & w.value) != 0;
+        default:
+            return false;
+        }
+    }
+
+    std::mutex mutex;
+    std::vector<Waiter> waiters;
+    std::atomic<size_t> count{};
+};
+
+} // namespace Tegra
diff --git a/src/video_core/nx2_profile.h b/src/video_core/nx2_profile.h
new file mode 100644
index 0000000..a921b72
--- /dev/null
+++ b/src/video_core/nx2_profile.h
@@ -0,0 +1,198 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <chrono>
+#include <cstdlib>
+#include <string>
+#include <unordered_set>
+
+#include "common/common_types.h"
+#include "common/logging.h"
+#include "common/cpu_features.h"
+
+// EDEN_NX2_GPU_PROFILE: time where the GPU thread spends its time. Each zone counts its own
+// (exclusive) time, nested zones excluded; every 10 s the thread logs each zone's share.
+namespace VideoCommon::Nx2Profile {
+
+enum class Zone : u32 {
+    Other, ///< GPU thread time outside every zone below (register writes, command parsing)
+    Idle,
+    PendingSleep,
+    ResumePending,
+    Push,
+    Tick,
+    Run,
+    FlushInvalidate,
+    Macro,
+    Draw,
+    Clear,
+    Compute,
+    FlushWork,
+    PipelineLookup,
+    Configure,
+    SyncDescriptors,
+    ReadHandles,
+    FillImageViews,
+    TextureBuffers,
+    UpdateBuffers,
+    DescriptorAcquire,
+    BindStageBuffers,
+    PushDescriptors,
+    RenderTargets,
+    ConfigureDraw,
+    DynamicState,
+    DrawRecord,
+    TextureUpload,
+    Fence,        ///< Fences made (SignalFence)
+    FenceSkipped, ///< Empty fences not made
+    Method,       ///< Engine method calls (what a split GPU thread's back half would run)
+    SplitDrain,   ///< Split GPU thread: the front waits for the back (gpu_split.h)
+    SplitWait,    ///< Split GPU thread: the back waits for work
+    Count,
+};
+
+inline constexpr std::array<const char*, static_cast<size_t>(Zone::Count)> zone_names{
+    "other",         "idle",          "pending sleep",  "resume pending", "push",
+    "tick",          "run",           "flush/inval",    "macro",          "draw",
+    "clear",         "compute",       "flush work",     "pipeline lookup", "configure",
+    "sync descriptors", "read handles", "fill image views", "texture buffers", "update buffers",
+    "descriptor acquire", "bind stage buffers", "push descriptors", "render targets",
+    "configure draw", "dynamic state", "draw record", "texture upload", "fence",
+    "fence skipped", "method", "split drain", "split wait",
+};
+
+// Read once at startup: Enabled() runs several times per method write (no guard to check).
+inline const bool g_enabled = std::getenv("EDEN_NX2_GPU_PROFILE") != nullptr;
+
+inline bool Enabled() {
+    return g_enabled;
+}
+
+// Nanoseconds; from the host's own counter where the wall clock reads it directly (the zones
+// run ~150,000 times a second, and QueryPerformanceCounter cost ~5% of the GPU thread).
+inline u64 Now() {
+    return static_cast<u64>(Common::g_wall_clock.GetTimeNS().count());
+}
+
+struct ThreadData {
+    std::array<u64, static_cast<size_t>(Zone::Count)> exclusive_ns{};
+    std::array<u64, static_cast<size_t>(Zone::Count)> count{};
+    std::array<u64, 8> counters{}; ///< See Counter
+    u64 child_ns{};    ///< Time of the zones nested in the current one
+    u64 window_start{};
+};
+
+inline thread_local ThreadData t_data;
+
+class Scope {
+public:
+    explicit Scope(Zone zone_) : zone{zone_}, enabled{Enabled()} {
+        if (!enabled) {
+            return;
+        }
+        parent_child_ns = t_data.child_ns;
+        t_data.child_ns = 0;
+        start = Now();
+    }
+
+    ~Scope() {
+        if (!enabled) {
+            return;
+        }
+        const u64 elapsed = Now() - start;
+        auto& data = t_data;
+        const auto index = static_cast<size_t>(zone);
+        data.exclusive_ns[index] += elapsed - data.child_ns;
+        ++data.count[index];
+        data.child_ns = parent_child_ns + elapsed;
+    }
+
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+
+private:
+    Zone zone;
+    bool enabled;
+    u64 start{};
+    u64 parent_child_ns{};
+};
+
+/// Amounts counted on the GPU thread, logged per second with the zones.
+enum class Counter : u32 {
+    DownloadBytes,  ///< Buffer data copied back from the host GPU at fences
+    DownloadCopies, ///< Buffer ranges copied back
+    DmaReadBytes,   ///< Guest memory the native MME read with DMA
+    DownloadBytesOnDmaPages, ///< Of DownloadBytes: on pages the MME has DMA-read
+    MethodWrites,   ///< 3D register writes (Maxwell3D::CallMethod below the macro range)
+    SameValueWrites, ///< Of MethodWrites: the register already held the value
+    AcquireChecks,  ///< Semaphore acquires evaluated
+    AcquireWaits,   ///< Of AcquireChecks: not met yet (the channel waits)
+};
+
+/// Device pages (4 KiB) the native MME has DMA-read since start (GPU thread only; filled only
+/// while profiling): which buffer downloads anything on the GPU thread reads back.
+inline std::unordered_set<u64>& DmaReadPages() {
+    static std::unordered_set<u64> pages;
+    return pages;
+}
+
+inline void Add(Counter counter, u64 amount) {
+    if (Enabled()) {
+        t_data.counters[static_cast<size_t>(counter)] += amount;
+    }
+}
+
+/// Called by the GPU thread (and the split's back thread) between commands: logs and resets
+/// the totals every 10 s.
+inline void Report(const char* thread_name = "GPU thread") {
+    if (!Enabled()) {
+        return;
+    }
+    auto& data = t_data;
+    const u64 now = Now();
+    if (data.window_start == 0) {
+        data.window_start = now;
+        data.child_ns = 0;
+        return;
+    }
+    const u64 window = now - data.window_start;
+    if (window < 10'000'000'000ULL) {
+        return;
+    }
+    // Time in no zone at all is the wall time minus the zones' totals.
+    u64 zoned{};
+    for (size_t i = 1; i < data.exclusive_ns.size(); ++i) {
+        zoned += data.exclusive_ns[i];
+    }
+    data.exclusive_ns[0] = window > zoned ? window - zoned : 0;
+    std::string line;
+    for (size_t i = 0; i < data.exclusive_ns.size(); ++i) {
+        if (data.exclusive_ns[i] == 0 && data.count[i] == 0) {
+            continue;
+        }
+        // Per second of wall time: milliseconds spent and calls made.
+        const double ms = static_cast<double>(data.exclusive_ns[i]) * 1000.0 / window;
+        const double calls = static_cast<double>(data.count[i]) * 1e9 / window;
+        line += fmt::format(" | {} {:.1f} ms ({:.0f}/s)", zone_names[i], ms, calls);
+    }
+    line += fmt::format(" | buffer downloads {:.0f} KiB in {:.0f} copies ({:.0f} KiB on pages "
+                        "MME DMA reads) | MME DMA reads {:.0f} KiB",
+                        static_cast<double>(data.counters[0]) * 1e9 / 1024.0 / window,
+                        static_cast<double>(data.counters[1]) * 1e9 / window,
+                        static_cast<double>(data.counters[3]) * 1e9 / 1024.0 / window,
+                        static_cast<double>(data.counters[2]) * 1e9 / 1024.0 / window);
+    line += fmt::format(" | 3D register writes {:.0f} ({:.0f} same value)",
+                        static_cast<double>(data.counters[4]) * 1e9 / window,
+                        static_cast<double>(data.counters[5]) * 1e9 / window);
+    line += fmt::format(" | acquires {:.0f} ({:.0f} waited)",
+                        static_cast<double>(data.counters[6]) * 1e9 / window,
+                        static_cast<double>(data.counters[7]) * 1e9 / window);
+    LOG_INFO(HW_GPU, "{} per second:{}", thread_name, line);
+    data = {};
+    data.window_start = now;
+}
+
+} // namespace VideoCommon::Nx2Profile
