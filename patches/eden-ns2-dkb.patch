+    auto broken = input;
+    broken[2].words[1] = 1;
+    REQUIRE_FALSE(Shader::Ampere::LowerToMaxwell(broken));
+    broken = input;
+    broken[0].words[1] = 32;
+    REQUIRE_FALSE(Shader::Ampere::LowerToMaxwell(broken));
+    broken = input;
+    broken[1].words[0] = 0x7947;
+    REQUIRE_FALSE(Shader::Ampere::LowerToMaxwell(broken));
+}
