+        switch (Shader::Maxwell::Decode(word)) {
+        case Opcode::MOV_reg: visitor.MOV_reg(word); break;
+        case Opcode::TEX: visitor.TEX(word); break;
+        case Opcode::EXIT: break;
+        default: FAIL("Unexpected cube sampling lowering");
+        }
