+struct Maxwell3D::FrontState {
+    std::array<ControlWrite, 16> control_writes{};
+    u32 control_count{};
+    std::array<u32, Regs::NUM_REGS> regs{};
+    std::array<u32, Regs::NUM_REGS> shadow{};
+    Regs::ShadowRamControl control{};
+    u32 executing_macro{};
