+    u32 stores = 0;
+    for (const auto* block : program.blocks) {
+        for (const auto& inst : block->Instructions()) {
+            if (inst.GetOpcode() != IR::Opcode::SetAttribute) continue;
+            ++stores;
+            REQUIRE(inst.Arg(1).IsImmediate());
+            REQUIRE(inst.Arg(1).F32() == 5.0f);
