+    REQUIRE(writes == (sparse ? std::vector<u32>{0, 1, 35} : std::vector<u32>{0, 1, 2, 3}));
+    REQUIRE(components == (sparse ? std::vector<u32>{0, 1, 3} : std::vector<u32>{0, 1, 2, 3}));
+    REQUIRE(copies == std::vector<std::pair<u32, u32>>{{250, 7}, {251, 9}});
+}
