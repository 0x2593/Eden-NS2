+    REQUIRE_FALSE(DecodeNativeSparseRemap(entry));
+    entry.pages = 1;
+    entry.destination_pages = ~0ULL >> 12;
+    REQUIRE_FALSE(DecodeNativeSparseRemap(entry));
+    entry.destination_pages = 0x8100000;
+    entry.source_pages = ~0ULL;
+    REQUIRE_FALSE(DecodeNativeSparseRemap(entry));
+    entry.source_pages = 1;
+    entry.handle = 0;
+    REQUIRE_FALSE(DecodeNativeSparseRemap(entry));
+    entry.source_pages = 0;
+    REQUIRE(DecodeNativeSparseRemap(entry));
+    entry.reserved = 1;
+    REQUIRE_FALSE(DecodeNativeSparseRemap(entry));
+    const auto native = MakeNativeGpuCharacteristics(std::array<u8, 0xa0>{});
+    u64_le flags;
+    std::memcpy(&flags, native.data() + 0x50, sizeof(flags));
+    REQUIRE((u64{flags} & (1ULL << 35)) != 0);
+}
+
+TEST_CASE("Native sparse replacement preserves source offsets and only retains live handles", "[native-gpu]") {
+    using namespace Service::Nvidia::Devices;
+    NativeSparseMappingTable table;
+    table.Replace({0x1000, 0x6000, 0x2000, 7});
+    table.Replace({0x3000, 0x1000, 0x9000, 8});
+    REQUIRE(table.Ranges().size() == 3);
+    REQUIRE(table.Ranges().at(0x1000).size == 0x2000);
+    REQUIRE(table.Ranges().at(0x4000).source_offset == 0x5000);
+    REQUIRE(table.ReferencedHandles() == std::set<u32>{7, 8});
+    table.Replace({0x2000, 0x4000, 0, 0});
+    REQUIRE(table.Ranges().size() == 2);
+    REQUIRE(table.Ranges().at(0x1000).size == 0x1000);
+    REQUIRE(table.Ranges().at(0x6000).source_offset == 0x7000);
+    REQUIRE(table.ReferencedHandles() == std::set<u32>{7});
+    table.Replace({0x1000, 0x6000, 0, 9});
+    REQUIRE(table.Ranges().size() == 1);
+    REQUIRE(table.ReferencedHandles() == std::set<u32>{9});
+    table.Replace({0x1000, 0x6000, 0, 0});
+    REQUIRE(table.Ranges().empty());
+    REQUIRE(table.ReferencedHandles().empty());
+}
+
+TEST_CASE("Native sparse overlapping batches agree with an independent per-page model", "[native-gpu]") {
+    using namespace Service::Nvidia::Devices;
+    NativeSparseMappingTable table;
+    std::array<std::pair<u32, u64>, 64> pages{};
+    u32 random = 0x12345678;
+    for (u32 step = 0; step < 120; ++step) {
+        random = random * 1664525U + 1013904223U;
+        const u32 first = (random >> 16) % 64;
+        const u32 count = 1 + (random >> 24) % (64 - first);
+        const u32 handle = (random >> 8) % 5;
+        const u64 source = (random & 255) * 0x1000ULL;
+        table.Replace({0x1000ULL * first, 0x1000ULL * count, source, handle});
+        for (u32 i = 0; i < count; ++i) pages[first + i] = {handle, handle ? source + i * 0x1000ULL : 0};
+        std::set<u32> expected_handles;
+        for (u32 i = 0; i < 64; ++i) {
+            const u64 address = i * 0x1000ULL;
+            const auto it = table.Ranges().upper_bound(address);
+            u32 found_handle{};
+            u64 found_offset{};
+            if (it != table.Ranges().begin()) {
+                const auto& range = std::prev(it)->second;
+                if (address < range.address + range.size) {
+                    found_handle = range.handle;
+                    found_offset = range.source_offset + address - range.address;
+                }
+            }
+            REQUIRE(found_handle == pages[i].first);
+            REQUIRE(found_offset == pages[i].second);
+            if (pages[i].first) expected_handles.insert(pages[i].first);
+        }
+        REQUIRE(table.ReferencedHandles() == expected_handles);
+    }
+}
+
+TEST_CASE("Native root-table FIFO preserves uploaded color constants and partial updates", "[native-gpu]") {
+    Tegra::NativeRootTables tables;
+    constexpr std::array<u32, 8> matrix{
+        0x3f209d8c, 0x3ea897a6, 0x3d31699a, 0x3f800000,
+        0x3d8d82ba, 0x3f6b66f9, 0x3c3a2454, 0};
+    tables.Select(0);
+    for (const auto word : matrix) REQUIRE(tables.Load(word));
+    for (u32 i = 0; i < matrix.size(); ++i) REQUIRE(tables.Read(24, i * 4) == matrix[i]);
+    // A repeated selector write restarts the FIFO even though its register value is unchanged.
+    tables.Select(0);
+    REQUIRE(tables.Load(0x3f800000));
+    REQUIRE(tables.Read(24, 0) == 0x3f800000);
+    REQUIRE(tables.Read(24, 4) == matrix[1]);
+    tables.Select((28 << 8) | 7);
+    REQUIRE(tables.Load(0x12345678));
+    REQUIRE(tables.Read(31, 28) == 0x12345678);
+    REQUIRE(tables.Read(24, 28) == matrix[7]);
+    Tegra::NativeRootTables other_engine;
+    REQUIRE(other_engine.Read(24, 0) == 0);
+    REQUIRE(other_engine.Read(31, 28) == 0);
+}
+
+TEST_CASE("Native root-table uploads validate byte offsets and table boundaries", "[native-gpu]") {
+    Tegra::NativeRootTables tables;
+    tables.Select((252 << 8) | 3);
+    REQUIRE(tables.Load(0x87654321));
+    REQUIRE_FALSE(tables.Load(0xdeadbeef));
+    REQUIRE(tables.Read(27, 252) == 0x87654321);
+    REQUIRE(tables.Read(28, 0) == 0);
+    tables.Select(1 << 8);
+    REQUIRE_FALSE(tables.Load(42));
+    REQUIRE(tables.Read(24, 0) == 0);
+    REQUIRE(tables.Read(24, 256) == 0);
+    REQUIRE(tables.Read(23, 0) == 0);
+    REQUIRE(tables.Read(32, 0) == 0);
+    REQUIRE(Tegra::NativeRootTables::IsBank(24));
+    REQUIRE(Tegra::NativeRootTables::IsBank(31));
+    REQUIRE_FALSE(Tegra::NativeRootTables::IsBank(23));
+    REQUIRE_FALSE(Tegra::NativeRootTables::IsBank(32));
+}
diff --git a/src/tests/core/program_metadata.cpp b/src/tests/core/program_metadata.cpp
new file mode 100644
index 0000000..b5af995
--- /dev/null
+++ b/src/tests/core/program_metadata.cpp
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <cstring>
+#include <memory>
+#include <vector>
+
+#include <catch2/catch_test_macros.hpp>
+#include <catch2/generators/catch_generators.hpp>
+
+#include "common/swap.h"
+#include "core/file_sys/program_metadata.h"
+#include "core/file_sys/romfs.h"
+#include "core/file_sys/vfs/vfs_vector.h"
+#include "core/loader/deconstructed_rom_directory.h"
+#include "core/loader/loader.h"
+
+namespace {
+template <typename T>
+void Put(std::vector<u8>& bytes, std::size_t offset, T value) {
+    std::memcpy(bytes.data() + offset, &value, sizeof(value));
+}
+
+std::vector<u8> MakeMetadata(bool extended) {
+    std::vector<u8> bytes(0x600);
+    std::memcpy(bytes.data(), "META", 4);
+    bytes[0xC] = 7;
+    Put(bytes, 0x1C, u32_le{0x100000});
+    Put(bytes, 0x70, u32_le{0x500});
+    Put(bytes, 0x74, u32_le{0x100});
+    Put(bytes, 0x78, u32_le{0x80});
+    Put(bytes, 0x7C, u32_le{0x380});
+    const std::size_t acid = 0x80 + (extended ? 0x300 : 0x200);
+    const u32 fac = extended ? 0x340 : 0x240;
+    std::memcpy(bytes.data() + acid, "ACID", 4);
+    Put(bytes, acid + 0x20, u32_le{fac});
+    Put(bytes, acid + 0x24, u32_le{0x2C});
+    Put(bytes, 0x80 + fac + 4, u64_le{0x1234});
+    std::memcpy(bytes.data() + 0x500, "ACI0", 4);
+    Put(bytes, 0x510, u64_le{0x0100123456780000});
+    Put(bytes, 0x520, u32_le{0x40});
+    Put(bytes, 0x524, u32_le{0x1C});
+    Put(bytes, 0x530, u32_le{0x80});
+    Put(bytes, 0x534, u32_le{4});
+    Put(bytes, 0x544, u64_le{0x5678});
+    Put(bytes, 0x580, u32_le{0x030043F7});
+    return bytes;
+}
+} // namespace
+
+TEST_CASE("Program metadata reads both ACID layouts and relative access offsets", "[loader][npdm]") {
+    const bool extended = GENERATE(false, true);
+    FileSys::ProgramMetadata metadata;
+    REQUIRE(metadata.Load(std::make_shared<FileSys::VectorVfsFile>(MakeMetadata(extended))) ==
+            Loader::ResultStatus::Success);
+    REQUIRE(metadata.UsesExtendedAcid() == extended);
+    REQUIRE(metadata.GetTitleID() == 0x0100123456780000);
+    REQUIRE(metadata.GetFilesystemPermissions() == 0x5678);
+    REQUIRE(metadata.GetMainThreadStackSize() == 0x100000);
+    REQUIRE(metadata.GetKernelCapabilities() == std::vector<u32>{0x030043F7});
+}
+
+TEST_CASE("Program metadata rejects invalid sections", "[loader][npdm]") {
+    const bool extended = GENERATE(false, true);
+    auto bytes = MakeMetadata(extended);
+    const std::size_t acid = 0x80 + (extended ? 0x300 : 0x200);
+    Loader::ResultStatus expected{};
+    SECTION("NPDM magic") {
+        bytes[0] = 0;
+        expected = Loader::ResultStatus::ErrorBadNPDMHeader;
+    }
+    SECTION("ACID past EOF") {
+        Put(bytes, 0x78, u32_le{0xFFFFFFF0});
+        expected = Loader::ResultStatus::ErrorBadACIDHeader;
+    }
+    SECTION("ACID magic") {
+        bytes[acid] = 0;
+        expected = Loader::ResultStatus::ErrorBadACIDHeader;
+    }
+    SECTION("ACI magic") {
+        bytes[0x500] = 0;
+        expected = Loader::ResultStatus::ErrorBadACIHeader;
+    }
+    SECTION("FAH outside its section") {
+        Put(bytes, 0x520, u32_le{0xF0});
+        expected = Loader::ResultStatus::ErrorBadFileAccessHeader;
+    }
+    SECTION("FAC outside its section") {
+        Put(bytes, acid + 0x20, u32_le{0xFFFFFFF0});
+        expected = Loader::ResultStatus::ErrorBadFileAccessControl;
+    }
+    SECTION("Truncated FAH") {
+        Put(bytes, 0x524, u32_le{0x10});
+        expected = Loader::ResultStatus::ErrorBadFileAccessHeader;
+    }
+    SECTION("Capabilities outside their section") {
+        Put(bytes, 0x530, u32_le{0x100});
+        expected = Loader::ResultStatus::ErrorBadKernelCapabilityDescriptors;
+    }
+    SECTION("Unaligned capability count") {
+        Put(bytes, 0x534, u32_le{3});
+        expected = Loader::ResultStatus::ErrorBadKernelCapabilityDescriptors;
+    }
+    FileSys::ProgramMetadata metadata;
+    REQUIRE(metadata.Load(std::make_shared<FileSys::VectorVfsFile>(std::move(bytes))) == expected);
+}
+
+TEST_CASE("Reloading legacy metadata clears extended ACID state", "[loader][npdm]") {
+    FileSys::ProgramMetadata metadata;
+    REQUIRE(metadata.Load(std::make_shared<FileSys::VectorVfsFile>(MakeMetadata(true))) ==
+            Loader::ResultStatus::Success);
+    REQUIRE(metadata.UsesExtendedAcid());
+    REQUIRE(metadata.Load(std::make_shared<FileSys::VectorVfsFile>(MakeMetadata(false))) ==
+            Loader::ResultStatus::Success);
+    REQUIRE_FALSE(metadata.UsesExtendedAcid());
+    REQUIRE(metadata.Load(nullptr) == Loader::ResultStatus::ErrorBadNPDMHeader);
+}
+
+TEST_CASE("ExeFS main takes precedence over standalone NSO", "[loader][exefs]") {
+    auto directory = std::make_shared<FileSys::VectorVfsDirectory>();
+    auto main = std::make_shared<FileSys::VectorVfsFile>(std::vector<u8>{'N', 'S', 'O', '0'},
+                                                        "main", directory);
+    directory->AddFile(main);
+    directory->AddFile(std::make_shared<FileSys::VectorVfsFile>(MakeMetadata(false), "main.npdm"));
+    REQUIRE(Loader::IdentifyFile(main) == Loader::FileType::DeconstructedRomDirectory);
+    directory->DeleteFile("main.npdm");
+    REQUIRE(Loader::AppLoader_DeconstructedRomDirectory::IdentifyType(main) == Loader::FileType::Error);
+}
+
+TEST_CASE("Extracted ExeFS exposes loose RomFS", "[loader][exefs]") {
+    const bool sibling = GENERATE(false, true);
+    auto root = std::make_shared<FileSys::VectorVfsDirectory>();
+    auto exefs = std::make_shared<FileSys::VectorVfsDirectory>(
+        std::vector<FileSys::VirtualFile>{}, std::vector<FileSys::VirtualDir>{}, "exefs", root);
+    root->AddDirectory(exefs);
+    auto main = std::make_shared<FileSys::VectorVfsFile>(std::vector<u8>{'N', 'S', 'O', '0'},
+                                                        "main", exefs);
+    exefs->AddFile(main);
+    exefs->AddFile(std::make_shared<FileSys::VectorVfsFile>(MakeMetadata(false), "main.npdm"));
+    auto romfs = std::make_shared<FileSys::VectorVfsDirectory>(
+        std::vector<FileSys::VirtualFile>{}, std::vector<FileSys::VirtualDir>{}, "romfs");
+    romfs->AddFile(std::make_shared<FileSys::VectorVfsFile>(std::vector<u8>{1, 2, 3}, "asset.bin"));
+    (sibling ? root : exefs)->AddDirectory(romfs);
+    Loader::AppLoader_DeconstructedRomDirectory loader(main);
+    FileSys::VirtualFile image;
+    REQUIRE(loader.ReadRomFS(image) == Loader::ResultStatus::Success);
+    const auto extracted = FileSys::ExtractRomFS(image);
+    REQUIRE(extracted != nullptr);
+    const auto asset = extracted->GetFile("asset.bin");
+    REQUIRE(asset != nullptr);
+    REQUIRE(asset->ReadAllBytes() == std::vector<u8>{1, 2, 3});
+}
