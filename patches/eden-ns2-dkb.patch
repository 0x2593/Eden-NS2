+                if (!(mask & (4U << lane))) {
+                    continue;
+                }
+                if (d.out_method[lane]) {
+                    Output(eax, d, d.out_method[lane]);
+                    mov(ecx, eax);
+                    and_(ecx, 0xfff);
+                    mov(dword[st + offsetof(State, method)], ecx);
