+++ b/src/shader_recompiler/frontend/ampere/program_override.h
@@ -0,0 +1,85 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <cstring>
+#include "shader_recompiler/frontend/ampere/lower_to_maxwell.h"
+
+namespace Shader::Ampere {
+
+inline u64 NativeProgramKey(std::span<const Instruction> source) {
+    u64 hash = 14695981039346656037ULL;
+    for (const auto& instruction : source) {
+        for (u32 word : instruction.words) {
+            for (u32 byte = 0; byte < 4; ++byte) hash = (hash ^ ((word >> (byte * 8)) & 255)) * 1099511628211ULL;
+        }
+    }
+    return hash;
+}
+
+// Private iteration format: version, lengths, texture bank, exact original
+// instructions, then the newly generated canonical instructions. Source bytes
+// are compared directly; the filename hash is only an index.
+inline std::vector<u8> EncodeProgramOverride(std::span<const Instruction> source,
+                                            const LoweredProgram& program) {
+    if (!program || program.source_size != source.size_bytes() || program.source_instruction_offsets.size() != source.size()) return {};
+    const std::array<u32, 6> header{0x4e454445, 0x3230564f,
+        static_cast<u32>(source.size_bytes()), static_cast<u32>(program.instructions.size()),
+        program.required_texture_buffer, static_cast<u32>(program.source_instruction_offsets.size())};
+    std::vector<u8> bytes(sizeof(header) + source.size_bytes() + program.instructions.size() * 8 + program.source_instruction_offsets.size() * 4);
+    std::memcpy(bytes.data(), header.data(), sizeof(header));
+    std::memcpy(bytes.data() + sizeof(header), source.data(), source.size_bytes());
+    std::memcpy(bytes.data() + sizeof(header) + source.size_bytes(), program.instructions.data(), program.instructions.size() * 8);
+    std::memcpy(bytes.data() + sizeof(header) + source.size_bytes() + program.instructions.size() * 8,
+                program.source_instruction_offsets.data(), program.source_instruction_offsets.size() * 4);
+    return bytes;
+}
+
+inline u32 ProgramOverrideSourceSize(std::span<const u8> bytes) {
+    std::array<u32, 6> header{};
+    if (bytes.size() < sizeof(header)) return 0;
+    std::memcpy(header.data(), bytes.data(), sizeof(header));
+    const bool mapped = header[1] == 0x3230564f;
+    if (header[0] != 0x4e454445 || (!mapped && header[1] != 0x3130564f) ||
+        (mapped ? header[5] != header[2] / 16 : header[5] != 0) ||
+        header[2] == 0 || header[2] % sizeof(Instruction) || header[2] > 1048576 ||
+        header[3] == 0 || header[3] > 1048576 || (header[4] != ~0U && header[4] >= 18)) return 0;
+    if (bytes.size() != sizeof(header) + size_t{header[2]} + size_t{header[3]} * 8 + size_t{header[5]} * 4) return 0;
+    return header[2];
+}
+
+inline LoweredProgram DecodeProgramOverride(std::span<const u8> bytes,
+                                            std::span<const Instruction> source) {
+    LoweredProgram result;
+    const auto fail = [&result](std::string_view message) {
+        result.instructions.clear();
+        result.source_instruction_offsets.clear();
+        result.error = message;
+        return result;
+    };
+    std::array<u32, 6> header{};
+    if (!ProgramOverrideSourceSize(bytes)) return fail("invalid native override header or length");
+    std::memcpy(header.data(), bytes.data(), sizeof(header));
+    if (header[2] != source.size_bytes()) return fail("native override source length mismatch");
+    if (std::memcmp(bytes.data() + sizeof(header), source.data(), source.size_bytes()))
+        return fail("native override source mismatch");
+    result.instructions.resize(header[3]);
+    std::memcpy(result.instructions.data(), bytes.data() + sizeof(header) + source.size_bytes(), header[3] * 8);
+    if (header[5]) {
+        result.source_instruction_offsets.resize(header[5]);
+        std::memcpy(result.source_instruction_offsets.data(),
+                    bytes.data() + sizeof(header) + source.size_bytes() + size_t{header[3]} * 8,
+                    size_t{header[5]} * 4);
+        u32 previous = 0;
+        for (u32 offset : result.source_instruction_offsets) {
+            if (offset >= result.instructions.size() || offset < previous)
+                return fail("native override address map mismatch");
+            previous = offset;
+        }
+    }
+    result.source_size = header[2];
+    result.required_texture_buffer = header[4];
+    return result;
+}
+
+} // namespace Shader::Ampere
diff --git a/src/shader_recompiler/frontend/ampere/register_pressure.h b/src/shader_recompiler/frontend/ampere/register_pressure.h
new file mode 100644
index 0000000..089d68d
--- /dev/null
+++ b/src/shader_recompiler/frontend/ampere/register_pressure.h
@@ -0,0 +1,107 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <array>
+#include <vector>
+#include "shader_recompiler/frontend/ampere/instruction.h"
+
+namespace Shader::Ampere {
+struct RegisterPressure {
+    Instruction instruction;
+    std::vector<u64> prefix, suffix;
+    bool valid = true;
+};
+inline u64 NativeRegisterCopy(u32 destination_bank, u32 destination, u32 source_bank, u32 source) {
+    return 0x5c98000000070000ULL | (u64{10} << 44) | destination |
+        (u64{destination_bank} << 8) | (u64{source_bank} << 10) | (u64{source} << 20);
+}
+// Preserve high guest registers in SSA while borrowing aligned low quartets
+// for one native instruction. The expanded instruction owns its temporary bank.
+inline RegisterPressure PrepareRegisterPressure(const Instruction& input, u32 reserved) {
+    RegisterPressure result{input};
+    struct Operand { u32 bit, count; };
+    std::vector<Operand> operands;
+    const auto operand = [&](u32 bit, u32 count = 1) { operands.push_back({bit, count}); };
+    const u32 opcode = input.Bits(0, 12);
+    switch (opcode) {
+    case 0x802: case 0xb08: case 0xd08: operand(16); break;
+    case 0x308: operand(16); operand(32); break;
+    case 0x433: case 0x633: operand(16); operand(24); break;
+    case 0x233: operand(16); operand(24); operand(32); break;
+    case 0x812: case 0x824: case 0x831: case 0x424: case 0x624:
+        operand(16); operand(24); operand(64); break;
+    case 0x230: case 0x231:
+        operand(16); operand(24); operand(32); operand(64); break;
+    case 0x819:
+        operand(16); operand(24); operand(64); break;
+    case 0x211:
+        operand(16); operand(24); operand(32); operand(64); break;
+    case 0xa11:
+        operand(16); operand(24); operand(64); break;
+    case 0x225: case 0x625: case 0x825:
+        operand(16, 2); operand(24);
+        if (opcode == 0x225) { operand(32); operand(64, 2); }
+        if (opcode == 0x625) operand(64);
+        if (opcode == 0x825) operand(64, 2);
+        break;
+    case 0x83b:
+        operand(16, input.Bits(72, 2) == 1 ? 2 : 4); operand(24); break;
+    case 0x23c:
+        operand(16, 2); operand(24, input.Bits(75, 1) ? 4 : 2);
+        operand(32, input.Bits(75, 1) ? 2 : 1); operand(64, 2); break;
+    case 0x388: case 0x984: {
+        const u32 width = input.Bits(73, 3), count = width == 6 ? 4 : width == 5 ? 2 : 1;
+        operand(opcode == 0x388 ? 32 : 16, count); operand(24); break;
+    }
+    case 0x387: case 0x983:
+        operand(opcode == 0x387 ? 32 : 16); operand(24); break;
+    case 0x981: case 0x986: {
+        const u32 width = input.Bits(73, 3), count = width == 6 ? 4 : width == 5 ? 2 : 1;
+        operand(opcode == 0x981 ? 16 : 32, count);
+        operand(24, input.Bits(72, 1) ? 2 : 1); break;
+    }
+    default:
+        result.valid = false; return result;
+    }
+    std::array<bool, 256> used{};
+    std::array<bool, 64> groups{};
+    for (const auto [bit, count] : operands) {
+        const u32 reg = input.Bits(bit, 8);
+        if (reg == 255) continue;
+        if (reg + count > 255) { result.valid = false; return result; }
+        for (u32 component = 0; component < count; ++component) {
+            used[reg + component] = true;
+            if (reg + component >= reserved) groups[(reg + component) / 4] = true;
+        }
+    }
+    std::array<u32, 64> mapped{};
+    for (u32 group = 0; group < groups.size(); ++group) {
+        if (!groups[group]) continue;
+        u32 borrow = reserved;
+        while (borrow >= 4) {
+            borrow -= 4;
+            if (!used[borrow] && !used[borrow + 1] && !used[borrow + 2] && !used[borrow + 3]) break;
+        }
+        if (used[borrow] || used[borrow + 1] || used[borrow + 2] || used[borrow + 3]) {
+            result.valid = false; return result;
+        }
+        mapped[group] = borrow;
+        for (u32 component = 0; component < 4; ++component) {
+            const u32 low = borrow + component, high = group * 4 + component;
+            used[low] = true;
+            result.prefix.push_back(NativeRegisterCopy(2, low, 0, low));
+            result.prefix.push_back(NativeRegisterCopy(0, low, 1, high));
+            result.suffix.push_back(NativeRegisterCopy(1, high, 0, low));
+            result.suffix.push_back(NativeRegisterCopy(0, low, 2, low));
+        }
+    }
+    for (const auto [bit, count] : operands) {
+        const u32 reg = input.Bits(bit, 8);
+        if (reg == 255 || !groups[reg / 4]) continue;
+        const u32 replacement = mapped[reg / 4] + reg % 4;
+        const u32 word = bit / 32, shift = bit % 32;
+        result.instruction.words[word] = (result.instruction.words[word] & ~(255U << shift)) | (replacement << shift);
+    }
+    return result;
+}
+} // namespace Shader::Ampere
diff --git a/src/shader_recompiler/frontend/ampere/translate.cpp b/src/shader_recompiler/frontend/ampere/translate.cpp
new file mode 100644
index 0000000..e183e39
--- /dev/null
+++ b/src/shader_recompiler/frontend/ampere/translate.cpp
@@ -0,0 +1,240 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Encoding reference: Mesa NAK sm70_encode.rs (MIT), Copyright 2022 Collabora, Ltd.
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+
+#include <fmt/format.h>
+
+#include "shader_recompiler/environment.h"
+#include "shader_recompiler/frontend/ampere/classify.h"
+#include "shader_recompiler/frontend/ampere/flow.h"
+#include "shader_recompiler/frontend/ampere/native.h"
+#include "shader_recompiler/frontend/ampere/visitor.h"
+#include "shader_recompiler/frontend/ir/basic_block.h"
+#include "shader_recompiler/object_pool.h"
+
+namespace Shader::Ampere {
+
+FrontendMode SelectedFrontendMode() {
+    static const FrontendMode mode = [] {
+        const char* const value = std::getenv("EDEN_NATIVE_FRONTEND");
+        if (!value) return FrontendMode::Lower;
+        if (!std::strcmp(value, "ampere")) return FrontendMode::Ampere;
+        if (!std::strcmp(value, "auto")) return FrontendMode::Auto;
+        if (!std::strcmp(value, "compare")) return FrontendMode::Compare;
+        return FrontendMode::Lower;
+    }();
+    return mode;
+}
+
+namespace {
+// Layouts other than the default are remembered by the content of the program, so that translating
+// its blocks later finds the layout its validation chose.
+u64 ProgramHash(std::span<const Instruction> program) {
+    u64 hash = 0xcbf29ce484222325ULL;
+    for (const Instruction& insn : program) {
+        for (const u32 word : insn.words) {
+            hash = (hash ^ word) * 0x100000001b3ULL;
+        }
+    }
+    return hash ^ (u64{program.size()} << 40);
+}
+
+std::mutex layout_mutex;
+std::unordered_map<u64, UniformLayout>& Layouts() {
+    static std::unordered_map<u64, UniformLayout> layouts;
+    return layouts;
+}
+
+void RunValidation(Environment& env, std::span<const Instruction> program, const FlowAnalysis& analysis,
+                   ProgramInfo& info, const UniformLayout& layout, bool probe) {
+    ObjectPool<IR::Inst> inst_pool;
+    ObjectPool<IR::Block> block_pool;
+    IR::Block* const scratch = block_pool.Create(inst_pool);
+    for (u32 index = 0; index < program.size(); ++index) {
+        if (!analysis.reachable[index]) continue;
+        // Branches are consumed by the control flow builder, not translated.
+        if (program[index].Bits(0, 12) == 0x947) continue;
+        Visitor{env, *scratch, program[index], index, &info, layout, probe}.Run();
+    }
+}
+} // Anonymous namespace
+
+UniformLayout LayoutOf(std::span<const Instruction> program) {
+    std::scoped_lock lock{layout_mutex};
+    const auto& layouts = Layouts();
+    if (layouts.empty()) {
+        return {};
+    }
+    const auto it = layouts.find(ProgramHash(program));
+    return it == layouts.end() ? UniformLayout{} : it->second;
+}
+
+namespace {
+ProgramInfo ValidateProgramImpl(Environment& env, std::span<const Instruction> program);
+} // Anonymous namespace
+
+namespace {
+// The verdict of validating a program depends only on its instructions and its branch tables, so it
+// is remembered: the same shader is validated again for every pipeline it appears in.
+struct Verdict {
+    bool accepted{};
+    ProgramInfo info;
+    u32 index{};
+    std::string reason;
+};
+
+std::mutex verdict_mutex;
+std::unordered_map<u64, Verdict>& Verdicts() {
+    static std::unordered_map<u64, Verdict> verdicts;
+    return verdicts;
+}
+
+u64 VerdictKey(Environment& env, std::span<const Instruction> program) {
+    u64 hash = ProgramHash(program);
+    const auto mix = [&hash](u32 value) { hash = (hash ^ value) * 0x100000001b3ULL; };
+    for (const u32 target : env.NativeIndirectTargets()) mix(target);
+    for (u32 index = 0; index < program.size(); ++index) {
+        const u32 op = program[index].Bits(0, 12);
+        if (op == 0x949 || op == 0x958) {
+            mix(index);
+            for (const u32 target : env.NativeIndirectTargetsAt(index)) mix(target);
+        }
+    }
+    return hash;
+}
+} // Anonymous namespace
+
+// Rejections carry the four words of the instruction they stopped at, so logs show what to decode.
+ProgramInfo ValidateProgram(Environment& env, std::span<const Instruction> program) {
+    const u64 key = VerdictKey(env, program);
+    {
+        std::scoped_lock lock{verdict_mutex};
+        if (const auto it = Verdicts().find(key); it != Verdicts().end()) {
+            if (it->second.accepted) {
+                return it->second.info;
+            }
+            throw UnsupportedError(it->second.index, it->second.reason);
+        }
+    }
+    Verdict verdict;
+    try {
+        verdict.info = ValidateProgramImpl(env, program);
+        verdict.accepted = true;
+    } catch (const UnsupportedError& error) {
+        verdict.index = error.index;
+        verdict.reason = error.what();
+        if (error.index < program.size()) {
+            const auto& words = program[error.index].words;
+            verdict.reason = fmt::format("{} [{:08x} {:08x} {:08x} {:08x}]", error.what(), words[0], words[1],
+                                         words[2], words[3]);
+        }
+    }
+    {
+        std::scoped_lock lock{verdict_mutex};
+        if (Verdicts().size() < 65536) {
+            Verdicts().emplace(key, verdict);
+        }
+    }
+    if (verdict.accepted) {
+        return verdict.info;
+    }
+    throw UnsupportedError(verdict.index, verdict.reason);
+}
+
+namespace {
+ProgramInfo ValidateProgramImpl(Environment& env, std::span<const Instruction> program) {
+    ProgramInfo info;
+    const IndirectTargetProvider per_branch = [&env](u32 index) { return env.NativeIndirectTargetsAt(index); };
+    const FlowAnalysis analysis = AnalyzeFlow(program, env.NativeIndirectTargets(), &per_branch);
+    try {
+        RunValidation(env, program, analysis, info, {}, false);
+        return info;
+    } catch (const UnsupportedError& error) {
+        if (std::string_view{error.what()}.find("reserved for the uniform file") == std::string_view::npos) {
+            throw;
+        }
+        // A GPR collides with the fixed uniform slots. Find out which registers the program really
+        // touches and pack the uniform file just above them.
+        ProgramInfo probe_info;
+        RunValidation(env, program, analysis, probe_info, {}, true);
+        UniformLayout layout;
+        layout.gpr_limit = probe_info.max_gpr + 1;
+        layout.predicate_slot = layout.gpr_limit;
+        layout.register_base = layout.gpr_limit + (probe_info.uses_up ? 1 : 0);
+        const u32 slots = probe_info.uses_any_ur ? probe_info.max_ur + 1 : 0;
+        if (std::getenv("EDEN_NATIVE_LAYOUT_DEBUG")) {
+            std::fprintf(stderr, "native layout: max_gpr=%u max_ur=%u uses_up=%d -> base=%u slots=%u\n",
+                         probe_info.max_gpr, probe_info.max_ur, probe_info.uses_up ? 1 : 0,
+                         layout.register_base, slots);
+        }
+        if (layout.register_base + slots > 255 || (probe_info.uses_up && layout.predicate_slot >= 255)) {
+            // Not enough room above the highest GPR: keep every GPR where it is and place the uniform
+            // file in the extra SSA variables above RZ.
+            layout = UniformLayout{};
+            layout.gpr_limit = 255;
+            layout.predicate_slot = 256;
+            layout.register_base = 257;
+            if (std::getenv("EDEN_NATIVE_LAYOUT_DEBUG")) {
+                std::fprintf(stderr, "native layout: extended file, %u slots\n", slots);
+            }
+        }
+        {
+            std::scoped_lock lock{layout_mutex};
+            Layouts()[ProgramHash(program)] = layout;
+        }
+        ProgramInfo real_info;
+        RunValidation(env, program, analysis, real_info, layout, false);
+        return real_info;
+    }
+}
+
+} // Anonymous namespace
+
+std::vector<std::string> CollectUnsupported(Environment& env, std::span<const Instruction> program) {
+    std::vector<std::string> reasons;
+    FlowAnalysis analysis;
+    try {
+        const IndirectTargetProvider per_branch = [&env](u32 index) { return env.NativeIndirectTargetsAt(index); };
+        analysis = AnalyzeFlow(program, env.NativeIndirectTargets(), &per_branch);
+    } catch (const UnsupportedError& e) {
+        reasons.emplace_back(e.what());
+        return reasons;
+    }
+    ObjectPool<IR::Inst> inst_pool;
+    ObjectPool<IR::Block> block_pool;
+    IR::Block* const scratch = block_pool.Create(inst_pool);
+    ProgramInfo info;
+    const UniformLayout layout = LayoutOf(program);
+    for (u32 index = 0; index < program.size(); ++index) {
+        if (!analysis.reachable[index] || program[index].Bits(0, 12) == 0x947) continue;
+        try {
+            Visitor{env, *scratch, program[index], index, &info, layout}.Run();
+        } catch (const UnsupportedError& e) {
+            reasons.emplace_back(e.what());
+        }
+    }
+    return reasons;
+}
+
+void Translate(Environment& env, IR::Block* block, u32 location_begin, u32 location_end) {
+    if (location_begin == location_end) return;
+    const std::span<const Instruction> program = env.NativeProgram();
+    const u32 begin = IndexOf(location_begin);
+    const u32 end = IndexOf(location_end);
+    if (begin == ~0U || end == ~0U || end > program.size() || begin > end) {
+        throw UnsupportedError(0, "native block range");
+    }
+    const UniformLayout layout = LayoutOf(program);
+    for (u32 index = begin; index < end; ++index) {
+        Visitor{env, *block, program[index], index, nullptr, layout}.Run();
+    }
+}
+
+} // namespace Shader::Ampere
diff --git a/src/shader_recompiler/frontend/ampere/trap_guards.h b/src/shader_recompiler/frontend/ampere/trap_guards.h
new file mode 100644
index 0000000..b84c436
--- /dev/null
+++ b/src/shader_recompiler/frontend/ampere/trap_guards.h
@@ -0,0 +1,112 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+
+#include <array>
+#include <functional>
+#include <optional>
+#include <span>
+#include "shader_recompiler/frontend/ampere/instruction.h"
+
+namespace Shader::Ampere {
+using TrapGuardReader = std::function<std::optional<u32>(u32, u32)>;
+
+// Evaluate only a bounded, uniform prologue. Unknown inputs or reachable traps reject the dispatch.
+inline bool VerifyTrapGuards(std::span<const Instruction> prefix, const TrapGuardReader& read) {
+    if (prefix.empty()) return true;
+    if (prefix.size() > 256 || !read) return false;
+    std::array<std::optional<u32>, 256> regs{};
+    std::array<std::optional<bool>, 8> predicates{};
+    regs[255] = 0;
+    predicates[7] = true;
+    const auto pred = [&](u32 code) -> std::optional<bool> {
+        const auto value = predicates[code & 7];
+        if (!value) return std::nullopt;
+        return *value != bool(code & 8);
+    };
+    for (u32 pc = 0, steps = 0; pc < prefix.size(); ++steps) {
+        if (steps >= 256) return false;
+        const auto& insn = prefix[pc];
+        const u32 op = insn.Bits(0, 12), dest = insn.Bits(16, 8);
+        const auto execute = pred(insn.Bits(12, 4));
+        if (!execute) return false;
+        if (!*execute) { ++pc; continue; }
+        const auto cbuf = [&]() -> std::optional<u32> {
+            if (insn.Bits(59, 5) || insn.Bits(38, 16) % 4) return std::nullopt;
+            return read(insn.Bits(54, 5), insn.Bits(38, 16));
+        };
+        const auto operand = [&](u32 which) -> std::optional<u32> {
+            if (which == 0) return regs[insn.Bits(24, 8)];
+            const u32 form = insn.Bits(9, 3);
+            if (form == 1) return regs[insn.Bits(32, 8)];
+            if (form == 4) return insn.words[1];
+            if (form == 5) return cbuf();
+            return std::nullopt;
+        };
+        std::optional<u32> value;
+        if (op == 0x95c) return false;
+        if (op == 0x947) {
+            if ((insn.words[0] & 0xffff0000U) || insn.words[2] != 0x03800000 || insn.words[1] % 16) return false;
+            const s64 target = s64{pc} + 1 + static_cast<s32>(insn.words[1]) / 16;
+            if (target <= pc) return false;
+            if (target >= static_cast<s64>(prefix.size())) return true;
+            pc = static_cast<u32>(target);
+            continue;
+        }
+        if (op == 0x388) {
+            if (insn.words[2] != 0) return false;
+            ++pc;
+            continue;
+        }
+        if (op == 0x624 || op == 0x424 || op == 0x224) {
+            if (insn.Bits(24, 8) != 255 || insn.Bits(64, 8) != 255 || insn.words[2] != 0x078e00ff)
+                return false;
+            if (op == 0x624) value = cbuf();
+            else if (op == 0x424) value = insn.words[1];
+            else value = regs[insn.Bits(32, 8)];
+        } else if (op == 0x207 || op == 0x807) {
+            if (insn.words[2] & ~0x07800000U) return false;
+            const auto select = pred(insn.Bits(87, 4));
+            if (!select) return false;
+            value = *select ? operand(0) : operand(1);
+        } else if (op == 0x212 || op == 0x812 || op == 0xa12) {
+            if ((insn.words[2] & ~0xffffU) != 0x078e0000 ||
+                (op != 0x812 && insn.Bits(62, 2)) || (op == 0x212 && (insn.words[1] & ~0xffU))) return false;
+            const auto a = operand(0), b = operand(1), c = regs[insn.Bits(64, 8)];
+            if (!a || !b || !c) return false;
+            u32 result{};
+            const u32 lut = insn.Bits(72, 8);
+            for (u32 bit = 0; bit < 32; ++bit) {
+                const u32 index = (((*a >> bit) & 1) << 2) | (((*b >> bit) & 1) << 1) | ((*c >> bit) & 1);
+                result |= ((lut >> index) & 1) << bit;
+            }
+            value = result;
+        } else if (op == 0x210 || op == 0x810 || op == 0xa10) {
+            if (insn.words[2] != 0x07ffe0ff || (op != 0x810 && insn.Bits(62, 2))) return false;
+            const auto a = operand(0), b = operand(1);
+            if (!a || !b) return false;
+            value = *a + *b;
+        } else if (op == 0x20c || op == 0x80c || op == 0xa0c) {
+            if ((insn.words[2] & ~0x078e7e00U) != 0x00700070 || insn.Bits(74, 2) > 2 ||
+                (op != 0x80c && insn.Bits(62, 2)) || (op == 0x20c && (insn.words[1] & ~0xffU))) return false;
+            const auto a = operand(0), b = operand(1);
+            const auto condition = pred(insn.Bits(87, 4));
+            if (!a || !b || !condition) return false;
+            const bool signed_compare = insn.Bits(73, 1);
+            const bool less = signed_compare ? static_cast<s32>(*a) < static_cast<s32>(*b) : *a < *b;
+            const bool equal = *a == *b;
+            const std::array<bool, 8> comparisons{false, less, equal, less || equal, !less && !equal, !equal, !less, true};
+            const bool comparison = comparisons[insn.Bits(76, 3)];
+            const u32 combine = insn.Bits(74, 2), target = insn.Bits(81, 3);
+            if (target != 7) predicates[target] = combine == 0 ? comparison && *condition :
+                combine == 1 ? comparison || *condition : comparison != *condition;
+            ++pc;
+            continue;
+        } else return false;
+        if (!value) return false;
+        if (dest != 255) regs[dest] = value;
+        ++pc;
+    }
+    return true;
+}
+} // namespace Shader::Ampere
