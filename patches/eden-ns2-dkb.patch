+        {{0x00377802, 0x00000030, 0x00000f00, 0}}, // native return PC
+        {{0x00007944, 0x00000020, 0x03c00000, 0}}, // call offset0x50
+        {{0xff007322, 0x00007003, 0x000000ff, 0}},
+        VertexTransform.back(),
