+                    mov(arg1.cvt32(), dword[st + offsetof(State, method)]);
+                    mov(arg0, st);
+                    call(ptr[st + offsetof(State, emit)]);
+                    test(al, al);
+                    jz(fail_emit, T_NEAR);
+                    mov(eax, dword[st + offsetof(State, increment)]);
+                    add(dword[st + offsetof(State, method)], eax);
+                }
