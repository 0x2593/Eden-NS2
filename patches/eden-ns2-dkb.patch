@@ -0,0 +1,37 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <optional>
+#include <span>
+#include "common/common_types.h"
+
+namespace Service::AM::GraphicsSupervisorProtocol {
+
+constexpr u8 DecodeBufferSlot(u32 packed) {
+    return static_cast<u8>(packed);
+}
+
+struct BootstrapRequest {
+    u32 process_handle;
+    u64 applet_resource_user_id;
+    u64 flags;
+    std::array<u64, 4> parameters;
+};
+
+inline std::optional<BootstrapRequest> DecodeBootstrap(std::span<const u32> packet) {
+    // Captured remote-memory bootstrap: TIPC 4, one copied handle, 48 data bytes.
+    if (packet.size() < 16 || packet[0] != 0x14 || packet[1] != 0x8000000c ||
+        packet[2] != 2) {
+        return std::nullopt;
+    }
+    const auto Read64 = [&](size_t index) {
+        return u64{packet[index]} | (u64{packet[index + 1]} << 32);
+    };
+    return BootstrapRequest{packet[3], Read64(4), Read64(6),
+                            {Read64(8), Read64(10), Read64(12), Read64(14)}};
+}
+
+} // namespace Service::AM::GraphicsSupervisorProtocol
diff --git a/src/core/hle/service/am/service/graphics_syncpoint_cache.h b/src/core/hle/service/am/service/graphics_syncpoint_cache.h
new file mode 100644
index 0000000..3df5e1e
--- /dev/null
+++ b/src/core/hle/service/am/service/graphics_syncpoint_cache.h
@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <array>
+#include <limits>
+#include <optional>
+#include "common/common_types.h"
+
+namespace Service::AM::GraphicsSyncpointCache {
+constexpr u32 ValuesOffset = 0x40;
+constexpr u32 GroupAckOffset = 0x640;
+constexpr u32 SlotAckOffset = 0x648;
+constexpr u32 GroupRequestOffset = 0;
+constexpr u32 SlotRequestOffset = 8;
+constexpr u32 CounterCount = 192;
+constexpr u32 GroupCount = (CounterCount + 63) / 64;
+constexpr u64 Unallocated = (std::numeric_limits<u64>::max)();
+
+constexpr std::array<u32, 8> Header{
+    1, 0, CounterCount - 1, ValuesOffset, GroupRequestOffset,
+    GroupAckOffset, SlotRequestOffset, SlotAckOffset};
+static_assert(ValuesOffset + CounterCount * sizeof(u64) <= GroupAckOffset);
+static_assert(SlotAckOffset + GroupCount * sizeof(u64) <= 0x2000);
+static_assert(SlotRequestOffset + GroupCount * sizeof(u64) <= 0x1000);
+
+constexpr u64 ExtendCounter(u64 previous, u32 current) {
+    if (previous == Unallocated) {
+        return current;
+    }
+    u64 high = previous & 0xffffffff00000000ULL;
+    if (current < static_cast<u32>(previous)) {
+        high += 1ULL << 32;
+    }
+    return high | current;
+}
+struct CounterValue {
+    u64 previous{Unallocated};
+
+    u64 Observe(std::optional<u32> current) {
+        if (!current) {
+            return Unallocated;
+        }
+        previous = ExtendCounter(previous, *current);
+        return previous;
+    }
+};
+} // namespace Service::AM::GraphicsSyncpointCache
diff --git a/src/core/hle/service/am/service/native_image_layout.h b/src/core/hle/service/am/service/native_image_layout.h
new file mode 100644
index 0000000..81bebe0
--- /dev/null
+++ b/src/core/hle/service/am/service/native_image_layout.h
@@ -0,0 +1,43 @@
+// SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#pragma once
+
+#include <optional>
+#include <span>
+#include "common/common_types.h"
+
+namespace Service::AM {
+
+struct NativeImageRequirements {
+    u64 size;
+    u64 alignment;
+};
+
+// Experimental inter-module block image layout, restricted to the observed
+// four-byte color format. Row pitch is in 64-byte GOBs; block height is in pixels.
+inline std::optional<NativeImageRequirements> CalculateNativeImageRequirements(
+    std::span<const u32> preference, u32 count) {
+    if (preference.size() != 16 || count != 1 || preference[0] != 0 ||
+        (preference[1] != 1 && preference[1] != 2) || preference[3] != 0 || preference[6] == 0 ||
+        preference[6] > 64 || preference[7] == 0 || preference[7] > 64 || preference[4] < 3 ||
+        preference[4] > 8) {
+        return std::nullopt;
+    }
+    for (size_t i = 8; i < preference.size(); ++i) {
+        if (preference[i] != 0) { return std::nullopt; }
+    }
+    const u64 width = (preference[2] & 0xffffU) + 1;
+    const u64 height = (preference[2] >> 16) + 1;
+    const u64 pitch_gobs = preference[5];
+    if (pitch_gobs < (width * 4 + 63) / 64 || pitch_gobs > 4096) {
+        return std::nullopt;
+    }
+    const u64 block_height = 1ULL << preference[4];
+    const u64 aligned_height = (height + block_height - 1) & ~(block_height - 1);
+    // Words 6 and 7 are unconfirmed (layers or mip levels); scaling by both never under-allocates.
+    const u64 surfaces = u64{preference[6]} * preference[7];
+    return NativeImageRequirements{pitch_gobs * 64 * aligned_height * surfaces, 64 * block_height};
+}
+
+} // namespace Service::AM
