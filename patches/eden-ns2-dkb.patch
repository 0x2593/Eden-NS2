+TEST_CASE("Native array texel fetch preserves layer and separates XY registers", "[native-shader]") {
+    std::array<Native, 2> input{{
+        {{0x06007b66, 0xb0800809, 0x009e0f02, 0}},
+        VertexTransform.back(),
