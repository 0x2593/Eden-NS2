+            else REQUIRE(inst.Arg(2).Inst()->Arg(0).Inst()->Arg(0).Reg() == IR::Reg{9});
+        }
+    }
+    REQUIRE(samples == 1);
+    REQUIRE(writes == std::vector<u32>{0, 1, 3});
