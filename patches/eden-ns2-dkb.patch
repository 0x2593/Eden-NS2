+TEST_CASE("Native texture component masks preserve sampled components", "[native-shader]") {
+    for (const u32 mask : {1U, 2U, 4U, 8U, 3U, 9U, 10U, 12U, 7U, 11U, 13U, 14U, 15U}) {
