+        const auto result = AllocateSpace(allocation);
+        if (result != NvResult::Success) { return result; }
+        m_syncpoint_shim_reserved = true;
+        gmmu->SetNativeSyncpointShim(address);
+    }
+    stride = sizeof(u32);
+    count = 192;
+    return NvResult::Success;
