+TEST_CASE("Native predicate-output LUTs preserve boolean bit tests", "[native-shader]") {
+    const std::array<Native, 3> input{{
+        {{0x00ff7812, 0x00000001, 0x0780c0ff, 0}},
+        {{0x01ff7812, 0x00000001, 0x07824802, 0}},
